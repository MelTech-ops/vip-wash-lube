---
import SiteLayout from "../layouts/SiteLayout.astro";
import { REVIEW_LINKS, LOCATIONS } from "../components/site/locations";
---

<SiteLayout
  title="Client Reviews | VIP Wash & Lube"
  description="Read reviews for VIP Wash & Lube in Stratford, Bridgeport and East Hartford, or leave one of your own on Google."
>
  <section class="grain relative isolate overflow-hidden navy-depth">
    <div class="relative mx-auto w-full max-w-[1400px] px-6 py-24 lg:px-10 lg:py-28">
      <p class="eyebrow-on-navy" data-reveal>Client Reviews</p>
      <h1 class="display-lg mt-6 max-w-3xl text-white" data-reveal style="--reveal-delay:90ms">
        Rated by the people<br /><span class="italic text-accent-on-navy">who drive away</span>
      </h1>
      <span class="rule-accent mt-8" data-reveal style="--reveal-delay:160ms"></span>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-navy-300" data-reveal style="--reveal-delay:220ms">
        Reviews come straight from each location&rsquo;s Google Business Profile. What you read here
        is what is on Google. Nothing curated, nothing written by us.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-[1400px] px-6 py-20 lg:px-10 lg:py-24">
    <div class="grid gap-6 md:grid-cols-3">
      {REVIEW_LINKS.map((r, i) => (
        <div class="flex flex-col border border-border p-9 transition-colors duration-500 hover:border-navy-900" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <p class="font-display text-3xl text-navy-900">{r.city}</p>
          <span class="rule-accent mt-4 mb-6"></span>
          <p class="text-sm leading-relaxed text-muted-foreground">
            The live Google rating and the most recent reviews for this shop appear here once the
            location&rsquo;s profile is connected.
          </p>
          <div class="mt-auto flex flex-wrap gap-3 pt-9">
            <a href={r.read} target="_blank" rel="noopener" class="border border-border px-5 py-2.5 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-navy-900 no-underline transition-colors hover:border-navy-900">
              Read on Google
            </a>
            <a href={r.write} target="_blank" rel="noopener" class="bg-navy-900 px-5 py-2.5 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-primary-foreground no-underline transition-colors hover:bg-navy-800">
              Leave a review
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-border bg-secondary">
    <div class="mx-auto flex w-full max-w-[1400px] flex-wrap items-center justify-between gap-8 px-6 py-16 lg:px-10">
      <div data-reveal>
        <h2 class="font-display text-3xl text-navy-900">Had your car detailed with us?</h2>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted-foreground">
          A review takes thirty seconds and it is the only advertising we have ever really needed.
        </p>
      </div>
      <div class="flex flex-wrap gap-3" data-reveal style="--reveal-delay:100ms">
        {LOCATIONS.map((loc, i) => (
          <a href={REVIEW_LINKS[i].write} target="_blank" rel="noopener" class="border border-navy-900 px-6 py-3 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-navy-900 no-underline transition-colors hover:bg-navy-900 hover:text-primary-foreground">
            Review {loc.city}
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
